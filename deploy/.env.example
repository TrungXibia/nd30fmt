# Mã quản trị (BẮT BUỘC khi mở ra Internet): chuỗi ngẫu nhiên >= 16 ký tự, tạo bằng
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Để trống = chế độ mở: ai vào được trang đều dùng được, nhưng không sửa được quy chuẩn dùng chung.
APP_TOKEN=

# Khoá giải mã bộ quy chuẩn đầy đủ (TUỲ CHỌN, do chủ dự án cấp): config/*_spec.yaml.enc, AES-256-GCM.
# Để trống -> dùng bộ quy chuẩn MẪU mở config/sample/*_spec.yaml (quy định bắt buộc của văn bản gốc),
# có thể sửa trực tiếp cho đơn vị mình. Kiểm tra đang dùng bộ nào: /healthz -> "spec": "sample" | "encrypted".
ND30_SPEC_KEY=

# Tiền tố URL khi chạy sau nginx, ví dụ https://example.com/nd30/
ROOT_PATH=/nd30
DATA_DIR=/data
JOB_TTL_HOURS=24
MAX_UPLOAD_MB=20
MAX_FILES=20

# Số file xử lý song song (VPS 1 GB RAM: để 1-2)
JOB_WORKERS=2

# Thông tin cơ quan ở đầu trang (bỏ trống: chỉ hiện tên ứng dụng)
# APP_NAME=Công cụ văn bản NĐ30
# ORG_PARENT=Tên cơ quan chủ quản
# ORG_NAME=Tên cơ quan, đơn vị
# ORG_TAGLINE=Công cụ soạn thảo, kiểm tra và chuẩn hoá thể thức văn bản hành chính, văn bản của Đảng và luận văn/đề án thạc sĩ
# ORG_UNIT=Tên phòng, bộ phận   (tên hiển thị trên thanh điều hướng)
# Logo: mặc định là biểu tượng dựng sẵn; đổi bằng ORG_LOGO=<link hoặc đường dẫn file> hoặc đặt config/logo.png

# Tab Chuyển Markdown (không bắt buộc)
# MD_MAX_PAGES=300      # số trang PDF tối đa mỗi file; vượt thì ghi rõ "Chỉ chuyển x/y trang đầu"
# MD_OCR_WORKERS=2      # số trang nhận dạng chữ chạy song song (mặc định = số nhân CPU, tối đa 4)
# MD_OCR_DPI=200        # độ phân giải ảnh trang khi nhận dạng chữ
# MD_OCR_PSM=4         # chế độ bố cục trang của tesseract (4: một cột; 6: một khối)

# Tab Chuyển đổi Âm thanh: phiên âm bằng Groq Whisper (cần ffmpeg, đã có trong Dockerfile)
# Mỗi người triển khai tự điền khoá Groq CỦA MÌNH (tạo tại https://console.groq.com/keys);
# phí/hạn mức phiên âm tính vào tài khoản đó. Để trống thì tab Âm thanh báo "Chưa cấu hình".
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3
# AUDIO_MAX_MB=90       # dung lượng tối đa mỗi tệp ghi âm (nginx phải cho phép lớn hơn mức này, xem deploy/nginx-nd30.conf)
# AUDIO_MAX_QUEUE=5     # số tệp tối đa cùng chờ/đang phiên âm; máy chủ xử lý từng tệp một
# WHISPER_TOKEN=        # chỉ cần khi để trống GROQ_API_KEY và tự chạy máy Whisper riêng (link ghi trong WHISPER_URL_FILE)

# Bảo mật (giá trị mặc định đã an toàn, chỉ đổi khi cần)
# AUTH_MAX_FAILS=20       # số lần nhập sai mã tối đa trong AUTH_WINDOW_S giây từ một địa chỉ, quá thì chặn tạm
# AUTH_WINDOW_S=600
# SHARE_TTL_DAYS=30       # link chia sẻ Markdown công khai hết hạn sau số ngày này (0 = không hết hạn)
# DOCX_MAX_UNZIP_MB=150   # dung lượng tối đa của tệp Word sau khi giải nén (chống tệp nén "bom")
# OPEN_ADMIN=1            # chỉ dùng trên máy cá nhân: cho phép sửa quy chuẩn khi không đặt APP_TOKEN
